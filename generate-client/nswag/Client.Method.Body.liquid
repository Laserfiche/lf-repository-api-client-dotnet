
// DEBUG: OperationId = {{ operation.OperationId }}
// DEBUG: Path = {{ operation.Path }}
{% if 
    operation.operationId == "UpdateEntry" or
    operation.operationId == "DeleteElectronicDocument" or
    operation.operationId == "DeletePages" or
    operation.operationId == "SetFields" or
    operation.operationId == "SetLinks" or
    operation.operationId == "SetTags" or
    operation.operationId == "SetTemplate" 
-%}
    Stopwatch sw = Stopwatch.StartNew();
    TimeSpan timeLimit = TimeSpan.FromSeconds(30);
    while (true) {
        try {
            if (sw.Elapsed > timeLimit) {
                throw new TimeoutException($"Operation was not successful after {sw.Elapsed}");
            }
            {% template Client.Method.Request %}
        }
        catch (ApiException ex) {
            string LockErrorCode = "[9014]";
            string EntrySharingErrorCode = "[9059]";
            if (ex.StatusCode != 423 && !ex.ProblemDetails.Title.Contains(EntrySharingErrorCode) && !ex.ProblemDetails.Title.Contains(LockErrorCode))
            {
                throw;
            }
        }
    }
{% else -%}
    {% template Client.Method.Request %}
{% endif %}
